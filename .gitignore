# Flutter and Dart generated files
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
ios/Flutter/ephemeral/

# Android local build state and machine-specific SDK paths
android/.gradle/
android/captures/
