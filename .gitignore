# Local FVM SDK link, editor files, and OS metadata
.fvm/
.idea/
*.iml
.DS_Store

# Release signing material — never commit these
android/key.properties
android/app/upload-keystore.jks
*.jks

# Build artifacts belong on GitHub Releases, not in the source tree
*.apk
*.aab

# Expo preview dependencies (separate from the Flutter app)
/expo-preview/node_modules/
/expo-preview/.expo/
/expo-preview/dist/

# Local-only distribution artifacts and internal notes
dist/
internal/

# Additional signing and environment material
*.keystore
*.p12
*.p8
*.mobileprovision
*.pem
.env
.env.*
**/google-services.json
**/GoogleService-Info.plist

# Editor and OS noise
.vscode/
xcuserdata/
*.xcuserstate
*.log

# Generated Android plugin registration
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Local iOS development team override
ios/Flutter/Local.xcconfig
